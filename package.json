{
  "name": "advosc",
  "version": "0.1.0",
  "description": "A VRChat OSC app for Windows: build a live chatbox out of blocks or raw templates, control and save avatar parameters, resize your avatar, and forward anything over OSC.",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:main": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "copy:natives": "xcopy /E /I /Y natives dist\\\\natives",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && bun run copy:natives && bun run build:main && bun run build:renderer",
    "dev:main": "concurrently \"vite build --config vite.main.config.ts --watch\" \"vite build --config vite.preload.config.ts --watch\"",
    "dev:renderer": "vite",
    "dev": "concurrently \"bun run dev:main\" \"bun run dev:renderer\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=true NODE_ENV=development electron .\"",
    "start": "electron .",
    "package": "bun run build && electron-forge package",
    "make": "bun run build && electron-forge make"
  },
  "keywords": [
    "vrchat",
    "vrchat-osc",
    "osc",
    "chatbox",
    "vrchat-chatbox",
    "avatar-parameters",
    "openvr",
    "steamvr",
    "vr",
    "heart-rate",
    "pulsoid",
    "now-playing",
    "electron",
    "svelte",
    "typescript",
    "rust",
    "windows"
  ],
  "author": "Kıraç Armağan Önal",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/TheArmagan/advosc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheArmagan/advosc.git"
  },
  "bugs": {
    "url": "https://github.com/TheArmagan/advosc/issues"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron/packager": "^19.0.1",
    "@internationalized/date": "^3.10.0",
    "@lucide/svelte": "^0.544.0",
    "@pulsoid/socket": "1.1.6",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@tsconfig/svelte": "^5.0.6",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.19.1",
    "@types/tail": "^2.2.3",
    "autoprefixer": "^10.4.22",
    "bits-ui": "^2.14.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "electron": "^33.4.11",
    "fflate": "^0.8.3",
    "gsap": "^3.13.0",
    "lodash": "^4.17.21",
    "monaco-editor": "^0.54.0",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "simple-eval": "^2.0.0",
    "stuffs": "^0.1.43",
    "svelte": "^5.43.8",
    "svelte-preprocess": "^6.0.3",
    "svelte-sonner": "^1.0.6",
    "tail": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.2.2",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "build/icon",
        "name": "ADVOSC",
        "executableName": "ADVOSC",
        "asar": {
          "unpack": "**/dist/**/*"
        },
        "prune": true,
        "ignore": [
          "^/(?!dist($|/)|node_modules($|/)|package\\.json$)",
          "/node_modules/\\.(?!pnpm($|/))[^/]+($|/)",
          "/node_modules/[^/]+/(test|tests|docs|doc|example|examples|benchmark|\\.github)($|/)",
          "/node_modules/.*\\.(md|markdown|ts|mts|cts|map|flow|tsbuildinfo)$"
        ],
        "win32metadata": {
          "CompanyName": "Kıraç Armağan Önal",
          "FileDescription": "ADVOSC, a VRChat OSC chatbox and avatar toolkit",
          "ProductName": "ADVOSC"
        }
      },
      "rebuildConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "advosc",
            "authors": "Kıraç Armağan Önal",
            "description": "ADVOSC, a VRChat OSC chatbox and avatar toolkit",
            "setupIcon": "build/icon.ico",
            "iconUrl": "https://raw.githubusercontent.com/TheArmagan/advosc/main/build/icon.ico",
            "setupExe": "ADVOSC-Setup.exe",
            "loadingGif": "build/icon.png",
            "noMsi": true
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        }
      ],
      "publishers": [],
      "plugins": []
    }
  },
  "trustedDependencies": [
    "svelte-preprocess",
    "electron-winstaller"
  ]
}