{
  "name": "advosc",
  "version": "1.0.0",
  "description": "Electron app with Svelte 5 and shadcn-svelte",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev:main": "concurrently \"vite build --config vite.main.config.ts --watch\" \"vite build --config vite.preload.config.ts --watch\"",
    "dev:renderer": "vite",
    "dev": "concurrently \"npm run dev:main\" \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=true NODE_ENV=development electron .\"",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "svelte",
    "typescript",
    "esbuild"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@internationalized/date": "^3.8.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@tsconfig/svelte": "^5.0.6",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.19.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "svelte": "^5.43.8",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.2.2",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "@lucide/svelte": "^0.544.0",
    "bits-ui": "^2.11.0",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "osc": "^2.4.5",
    "stuffs": "^0.1.43",
    "svelte-sonner": "^1.0.6",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.1.1",
    "tw-animate-css": "^1.4.0"
  }
}