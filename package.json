{
  "name": "advosc",
  "version": "1.0.0",
  "description": "Electron app with Svelte 5 and shadcn-svelte",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.js",
    "build:renderer": "node scripts/build-renderer.js",
    "build": "npm run build:main && npm run build:renderer",
    "dev:main": "node scripts/build-main.js --watch",
    "dev:renderer": "node scripts/build-renderer.js --watch",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"electron .\"",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "svelte",
    "typescript",
    "esbuild"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^22.19.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "esbuild-svelte": "^0.8.2",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "svelte": "^5.43.8",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@lucide/svelte": "^0.553.0",
    "bits-ui": "^1.8.0",
    "clsx": "^2.1.1",
    "osc": "^2.4.5",
    "stuffs": "^0.1.43",
    "svelte-sonner": "^1.0.6",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.1.1",
    "tw-animate-css": "^1.4.0"
  }
}