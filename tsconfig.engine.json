{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "lib": ["ES2023"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "$shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/engine/**/*", "src/shared/**/*"],
  "exclude": ["node_modules", "dist"]
}
